[init]
    defaultBranch = main

[core]
    editor = vim
    autocrlf = input
    excludesfile = ~/.gitignore_global

[color]
    ui = auto

[pull]
    rebase = false

[push]
    default = simple
    autoSetupRemote = true

[alias]
    st = status -sb
    co = checkout
    cb = checkout -b
    br = branch
    ci = commit
    cm = commit -m
    ca = commit --amend
    df = diff
    dfs = diff --staged
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    unstage = reset HEAD --
    last = log -1 HEAD
